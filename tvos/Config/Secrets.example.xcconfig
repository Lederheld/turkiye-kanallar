// Kopyalayıp doldurun:  cp Secrets.example.xcconfig Secrets.xcconfig
// Secrets.xcconfig git'e girmez (repo public).

// xcconfig'te "//" yorum başlattığı için adreste "https:/$()/" yazılır.
PLAYLIST_URL = https:/$()/gist.githubusercontent.com/KULLANICI_ADI/GIST_ID/raw/turkiye-kanallar.m3u

// Xcode > Settings > Accounts'taki ekip kimliği (10 karakter)
DEVELOPMENT_TEAM = ABCDE12345

// Size özgü olmalı (ücretsiz Apple hesabında başkasının kullandığı kimlik kabul edilmez)
APP_BUNDLE_ID = com.adiniz.turkiyetv
